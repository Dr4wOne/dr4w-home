// The showcase as a Cloudflare Worker with static assets only (no Worker script, no secrets).
// Deploy happens from CI after G3, never by hand: see docs/guides/deploy.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dr4w-home-showcase",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "home.dr4w.io", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
