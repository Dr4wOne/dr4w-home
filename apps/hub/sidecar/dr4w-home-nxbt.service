# dr4w home: the root nxbt sidecar (apps/hub/sidecar/nxbt-sidecar.py). A system service, because
# nxbt must run as root; the hub (a user service) reaches it only through the Unix socket below.
# Install by hand (packages/adapter-nintendo-switch/README.md). Root runs only root-owned copies under
# /opt/dr4w-home, never a file in the hub user's checkout that the hub user could change.
[Unit]
Description=dr4w home: Bluetooth controller sidecar (nxbt)
# Wants, not Requires: nxbt restarts bluetooth.service itself on start, and Requires would make
# systemd stop and restart the sidecar along with it.
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/opt/dr4w-home/nxbt-venv/bin/python -I /opt/dr4w-home/nxbt-sidecar.py --socket /run/dr4w-home/gamepad.sock --group dr4w-home
# Root (nxbt needs it), with the hub's group so /run/dr4w-home and the socket belong to that group.
Group=dr4w-home
Restart=on-failure
RestartSec=5
# nxbt's worker processes can leave the main process hanging on SIGTERM; don't wait 90 s for it.
TimeoutStopSec=5
# /run/dr4w-home (the socket) and /var/lib/dr4w-home-nxbt (the Switch's address, root only).
RuntimeDirectory=dr4w-home
RuntimeDirectoryMode=0750
StateDirectory=dr4w-home-nxbt
StateDirectoryMode=0700
UMask=0077
# Hardening that still lets nxbt use Bluetooth, D-Bus and its BlueZ override under /run/systemd.
# CAP_NET_BIND_SERVICE: the HID control and interrupt channels are L2CAP PSMs 17 and 19, which are
# privileged; without it nxbt retries the bind forever and never becomes discoverable.
ProtectSystem=full
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SYS_ADMIN CAP_NET_BIND_SERVICE
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
